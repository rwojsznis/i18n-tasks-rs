{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "cargo": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the minimum Rust version in Cargo.toml.",
      "managerFilePatterns": [
        "/(^|/)Cargo\\.toml$/"
      ],
      "matchStrings": [
        "rust-version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\""
      ],
      "datasourceTemplate": "rust-version",
      "depNameTemplate": "rust",
      "versioningTemplate": "rust"
    },
    {
      "customType": "regex",
      "description": "Update Cargo tools installed in GitHub Actions.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=crate depName=(?<depName>[^\\s]+)\\s+cargo install --locked [^\\s]+ --version (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "cargo"
    }
  ],
  "packageRules": [
    {
      "description": "Update the Rust toolchain and minimum supported version together.",
      "matchDatasources": [
        "rust-version"
      ],
      "matchPackageNames": [
        "rust"
      ],
      "groupName": "Rust toolchain",
      "groupSlug": "rust-toolchain"
    },
    {
      "description": "Automerge non-major dependency updates after required CI checks pass.",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "rebaseWhen": "behind-base-branch"
    }
  ]
}
